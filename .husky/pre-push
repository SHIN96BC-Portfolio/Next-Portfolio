#!/usr/bin/env bash
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 TypeScript 타입 검사 중..."

pnpm run typecheck

status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "❌ TypeScript 타입 검사에서 오류가 발견되었습니다. 푸시를 중단합니다."
  echo "   오류 내용을 확인하고 수정한 뒤 다시 시도해주세요."
  echo ""
  exit $status
fi

echo "✅ 타입 검사를 통과했습니다! 계속 진행합니다."

echo "🔍 전체 프로젝트에 대해 Biome 코드 검사 중..."

# 전체 코드 검사 실행
pnpm run biome

status=$?
if [ $status -ne 0 ]; then
  echo "❌ Biome 코드 검사에서 오류가 발견되었습니다. 푸시를 중단합니다."
  echo "   오류 내용을 확인하고 수정한 뒤 다시 시도해주세요."
  exit $status
fi

echo "✅ Biome 코드 검사를 통과했습니다!"

echo "✅ 모든 검사를 통과했습니다! 푸시를 계속 진행합니다."
