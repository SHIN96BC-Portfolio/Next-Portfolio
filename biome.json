{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "root": true,
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/public",
      "!**/node_modules",
      "!**/.next",
      "!**/.turbo",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/auto-gen/**",
      "!**/pnpm-lock.yaml"
    ],
    "maxSize": 41943040
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "a11y": {
        "noLabelWithoutControl": "off",
        "noNoninteractiveElementInteractions": "off",
        "noNoninteractiveTabindex": "off",
        "noPositiveTabindex": "off",
        "noRedundantAlt": "off",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useValidAnchor": "off"
      },
      "complexity": {
        "noCommaOperator": "off",
        "noExtraBooleanCast": "off",
        "noUselessTernary": "error",
        "useLiteralKeys": "off",
        "useRegexLiterals": "off"
      },
      "correctness": {
        "noInvalidUseBeforeDeclaration": "off",
        "noUndeclaredDependencies": "off",
        "noUnusedImports": "error",
        "noUnusedVariables": "off",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off"
      },
      "security": { "noDangerouslySetInnerHtml": "off" },
      "style": {
        "noNestedTernary": "off",
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "noRestrictedGlobals": { "level": "off", "options": {} },
        "useBlockStatements": "off",
        "useCollapsedElseIf": "error",
        "useConst": "error",
        "useTemplate": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "info"]
          }
        },
        "noDoubleEquals": "off",
        "noEmptyBlockStatements": "off",
        "noExplicitAny": "off",
        "noPrototypeBuiltins": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "html": { "formatter": { "selfCloseVoidElements": "always" } },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      "includes": ["apps/**/src/fsd/shared/**", "!apps/**/src/fsd/shared/config/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@FsdApp/**",
                      "@FsdPages/**",
                      "@FsdWidgets/**",
                      "@FsdFeatures/**",
                      "@FsdEntities/**",
                      "../app/**",
                      "../pages/**",
                      "../widgets/**",
                      "../features/**",
                      "../entities/**"
                    ],
                    "message": "🚫 shared 레이어에서는 app/pages/widgets/features/entities 를 import 할 수 없습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/**/src/fsd/entities/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@FsdApp/**",
                      "@FsdPages/**",
                      "@FsdWidgets/**",
                      "@FsdFeatures/**",
                      "../app/**",
                      "../pages/**",
                      "../widgets/**",
                      "../features/**"
                    ],
                    "message": "🚫 entities 레이어에서는 app/pages/widgets/features 를 import 할 수 없습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/**/src/fsd/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@FsdApp/**",
                      "@FsdPages/**",
                      "@FsdWidgets/**",
                      "../app/**",
                      "../pages/**",
                      "../widgets/**"
                    ],
                    "message": "🚫 features 레이어에서는 app/pages/widgets 를 import 할 수 없습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/**/src/fsd/widgets/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@FsdApp/**", "@FsdPages/**", "../app/**", "../pages/**"],
                    "message": "🚫 widgets 레이어에서는 app/pages 를 import 할 수 없습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/**/src/fsd/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@FsdApp/**", "../app/**"],
                    "message": "🚫 pages 레이어에서는 app 를 import 할 수 없습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["core/libs/**/*.{ts,tsx,js,jsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@Libs/**"],
                    "message": "🚫 @Libs/*는 deprecated. 패키지 내부는 상대경로, 다른 @core 패키지는 루트 엔트리(@core/<pkg>)만 사용하세요."
                  },
                  {
                    "group": ["@core/*/*/**"],
                    "message": "🚫 다른 @core 패키지의 내부 경로 import 금지. @core/<pkg> 루트(또는 package.json exports)만 사용하세요."
                  },
                  {
                    "group": [
                      "@Src/**",
                      "@FsdApp/**",
                      "@FsdPages/**",
                      "@FsdWidgets/**",
                      "@FsdFeatures/**",
                      "@FsdEntities/**",
                      "@FsdShared/**",
                      "@NextApp/**",
                      "@Public/**"
                    ],
                    "message": "🚫 @core 패키지에서 app 레이어 import 금지"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/**/src/**/*.{ts,tsx,js,jsx,mts,cts}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@core/*/*/**"],
                    "message": "🚫 @core/<pkg> 내부 경로 import 금지. 루트(@core/<pkg>) 또는 package.json exports만 사용하세요."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
