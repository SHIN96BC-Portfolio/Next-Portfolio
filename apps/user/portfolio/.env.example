# Portfolio verify / e2e용 최소 예시 env (실비밀 아님)
# 로컬: 이 파일을 참고해 `.env.local`을 만들거나, CI는 workflow에서 주입합니다.

NEXT_PUBLIC_API_MOCKING=enabled
NEXT_PUBLIC_API_SERVER_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_AUTH_SERVER_URL=http://127.0.0.1:8080

NEXTAUTH_URL=http://127.0.0.1:3010
NEXTAUTH_SECRET=harness-verify-nextauth-secret

# 알려진 debt — #31 SECURITY에서 서버 전용 env로 이전 예정
NEXT_PUBLIC_COOKIE_SECRET_KEY=harness-verify-cookie-secret-key
NEXT_PUBLIC_STORAGE_CRYPTO_SECRET_KEY=harness-verify-storage-secret
PRIVATE_COOKIE_SECRET_KEY=harness-verify-private-cookie-secret
