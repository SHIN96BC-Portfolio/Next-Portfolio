{
  "name": "next-portfolio-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:portfolio": "turbo dev --filter=@apps/user-portfolio",
    "dev:commerce": "turbo dev --filter=@apps/user-commerce",
    "dev:fashion": "turbo dev --filter=@apps/user-fashion",
    "dev:social": "turbo dev --filter=@apps/user-social",
    "dev:master-admin": "turbo dev --filter=@apps/admin-master-admin",
    "dev:commerce-admin": "turbo dev --filter=@apps/admin-commerce-admin",
    "dev:fashion-admin": "turbo dev --filter=@apps/admin-fashion-admin",
    "dev:social-admin": "turbo dev --filter=@apps/admin-social-admin",
    "build": "turbo build",
    "build:libs": "turbo build --filter=@core/*",
    "start:portfolio": "turbo start --filter=@apps/user-portfolio",
    "start:commerce": "turbo start --filter=@apps/user-commerce",
    "start:fashion": "turbo start --filter=@apps/user-fashion",
    "start:social": "turbo start --filter=@apps/user-social",
    "start:master-admin": "turbo start --filter=@apps/admin-master-admin",
    "start:commerce-admin": "turbo start --filter=@apps/admin-commerce-admin",
    "start:fashion-admin": "turbo start --filter=@apps/admin-fashion-admin",
    "start:social-admin": "turbo start --filter=@apps/admin-social-admin",
    "lint": "turbo lint",
    "lint:fix": "biome check --write .",
    "check-types": "turbo run typecheck",
    "typecheck": "pnpm run check-types",
    "test": "turbo test",
    "biome": "biome check . && node scripts/lint-fsd-ui-private-folders.mjs && node scripts/lint-fsd-folder-structure.mjs",
    "lint:fsd": "node scripts/lint-fsd-folder-structure.mjs",
    "lint:fsd:dry": "node scripts/lint-fsd-folder-structure.mjs --dry-run",
    "guard:harness": "node scripts/guard-harness.mjs",
    "guard:harness:strict": "node scripts/guard-harness.mjs --strict-denylist",
    "guard:tests": "node scripts/guard-tests.mjs",
    "guard:tests:soft": "node scripts/guard-tests.mjs --soft",
    "verify:app": "node scripts/verify-app.mjs",
    "verify:portfolio": "node scripts/verify-app.mjs portfolio",
    "verify:portfolio:snap": "node scripts/verify-app.mjs portfolio --snap",
    "verify:commerce": "node scripts/verify-app.mjs commerce",
    "verify:fashion": "node scripts/verify-app.mjs fashion",
    "verify:social": "node scripts/verify-app.mjs social",
    "verify:master-admin": "node scripts/verify-app.mjs master-admin",
    "verify:commerce-admin": "node scripts/verify-app.mjs commerce-admin",
    "verify:fashion-admin": "node scripts/verify-app.mjs fashion-admin",
    "verify:social-admin": "node scripts/verify-app.mjs social-admin",
    "loop:status": "node scripts/loop-status.mjs",
    "loop:lock": "node scripts/loop-lock.mjs",
    "loop:unlock": "node scripts/loop-unlock.mjs",
    "loop:budget": "node scripts/loop-budget.mjs",
    "loop:parse-issue": "node scripts/ai-loop-parse-issue.mjs",
    "snap": "node scripts/snap-route.mjs",
    "prepare": "husky",
    "gen:i18n": "pnpm --filter @apps/user-portfolio run gen:i18n",
    "gen:graphql": "pnpm --filter @apps/admin-master-admin run gen:graphql",
    "crypto:debug": "tsx scripts/cookie-crypto-debug.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@core/crypto": "workspace:*",
    "@types/node": "^20",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "tsx": "^4.20.3",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": ["biome check --no-errors-on-unmatched"]
  }
}
