{
  "name": "next-portfolio-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:portfolio": "turbo dev --filter=@apps/user-portfolio",
    "dev:admin": "turbo dev --filter=@apps/admin-master",
    "build": "turbo build",
    "build:libs": "turbo build --filter=@core/*",
    "start:portfolio": "turbo start --filter=@apps/user-portfolio",
    "start:admin": "turbo start --filter=@apps/admin-master",
    "lint": "turbo lint",
    "lint:fix": "biome check --write .",
    "check-types": "turbo run typecheck",
    "typecheck": "pnpm run check-types",
    "test": "turbo test",
    "biome": "biome check .",
    "prepare": "husky",
    "gen:i18n": "pnpm --filter @apps/user-portfolio run gen:i18n",
    "gen:graphql": "pnpm --filter @apps/admin-master run gen:graphql"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^20",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": ["biome check --no-errors-on-unmatched"]
  }
}
